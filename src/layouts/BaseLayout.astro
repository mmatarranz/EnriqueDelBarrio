---
import '../styles/global.css';
import siteConfig from '../data/site-config.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = `${siteConfig.brand} — Fotografía, Producción Editorial, Imprenta y Vídeo en Segovia`,
  description = 'Servicios profesionales de imprenta, maquetación, producción editorial, gran formato, fotografía aérea con dron y vídeo en Segovia. Tienda oficial de libros de Enrique del Barrio.',
  ogImage = '/prueba/images/hero/slide-segovia-callada.jpg',
  schema,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://enriquedelbarrio.es').toString();
const ogImageUrl = new URL(ogImage, Astro.site || 'https://enriquedelbarrio.es').toString();

const baseOrgSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': 'https://enriquedelbarrio.es/#organization',
  name: 'Enrique del Barrio — Estudio de Fotografía, Imprenta y Producción Editorial',
  alternateName: 'Juan Enrique del Barrio Arribas',
  url: 'https://enriquedelbarrio.es',
  logo: 'https://enriquedelbarrio.es/prueba/images/brand/logo.jpg',
  image: 'https://enriquedelbarrio.es/prueba/images/brand/enrique-del-barrio-retrato.jpg',
  telephone: '+34616551782',
  email: 'info@enriquedelbarrio.es',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Avenida Obispo Quesada 11',
    addressLocality: 'Segovia',
    addressRegion: 'Castilla y León',
    postalCode: '40006',
    addressCountry: 'ES',
  },
  areaServed: [
    { '@type': 'City', name: 'Segovia' },
    { '@type': 'AdministrativeArea', name: 'Castilla y León' },
    { '@type': 'Country', name: 'España' },
  ],
  sameAs: [
    siteConfig.social.facebook,
    siteConfig.social.instagram,
    siteConfig.social.linkedin,
    siteConfig.social.shutterstock,
    siteConfig.social.adobestock,
  ],
  knowsAbout: [
    'Imprenta en Segovia',
    'Producción editorial y edición de libros',
    'Maquetación y diseño gráfico',
    'Gran formato, expositores y vinilos',
    'Fotografía profesional y aérea con dron',
    'Vídeo institucional y eventos multicámara',
  ],
};

const jsonLdPayload = schema
  ? Array.isArray(schema)
    ? [baseOrgSchema, ...schema]
    : [baseOrgSchema, schema]
  : [baseOrgSchema];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteConfig.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data (SEO Tradicional + GEO / IA) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdPayload)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="overflow-x-hidden bg-stone-50 text-stone-900 antialiased selection:bg-amber-200 selection:text-stone-950 font-['Plus_Jakarta_Sans',sans-serif]">
    <header class="sticky top-0 z-40 border-b border-stone-200/80 bg-white/95 backdrop-blur-md">
      <div class="relative mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/prueba/" class="flex items-center justify-center md:justify-start flex-1 md:flex-none gap-2 shrink-0 group">
          <img
            src={siteConfig.images.logo}
            alt="Logotipo Enrique del Barrio"
            class="h-12 sm:h-14 md:h-12 w-auto rounded object-contain transition-transform group-hover:scale-[1.02]"
          />
        </a>

        <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-700">
          <div class="relative group py-2">
            <a href="/prueba/#servicios" class="inline-flex items-center gap-1 hover:text-amber-700 transition-colors">
              <span>Servicios</span>
              <span class="text-[10px]">▾</span>
            </a>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all absolute left-0 top-full w-64 rounded-2xl border border-stone-200 bg-white p-2 shadow-xl">
              <a href="/prueba/servicios/imprenta" class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 hover:text-amber-700">Imprenta</a>
              <a href="/prueba/servicios/maquetacion-y-diseno-grafico" class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 hover:text-amber-700">Maquetación y Diseño</a>
              <a href="/prueba/servicios/produccion-editorial" class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 hover:text-amber-700">Producción Editorial</a>
              <a href="/prueba/servicios/gran-formato" class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 hover:text-amber-700">Gran Formato y Vinilos</a>
              <a href="/prueba/servicios/fotografia" class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 hover:text-amber-700">Fotografía y Dron</a>
              <a href="/prueba/servicios/video-profesional" class="block rounded-xl px-3.5 py-2 text-xs font-semibold text-stone-700 hover:bg-stone-100 hover:text-amber-700">Vídeo Profesional</a>
            </div>
          </div>
          <a href="/prueba/tienda" class="hover:text-amber-700 transition-colors">Tienda Editorial</a>
          <a href="/prueba/quien-soy" class="hover:text-amber-700 transition-colors">Quién soy</a>
          <a href="/prueba/contacto" class="hover:text-amber-700 transition-colors">Contacto</a>
          <a
            href="/prueba/admin"
            class="rounded-full border border-stone-300 px-3 py-1 text-xs font-semibold text-stone-600 hover:border-stone-900 hover:text-stone-950 transition-colors"
          >
            Panel Admin
          </a>
        </nav>

        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`}
            class="hidden lg:inline-flex items-center gap-1.5 text-sm font-semibold text-stone-700 hover:text-amber-700 whitespace-nowrap"
          >
            <span>{siteConfig.phone}</span>
          </a>
          <a
            href="/prueba/tienda"
            class="inline-flex items-center gap-1.5 rounded-full bg-stone-900 px-3.5 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition-colors"
          >
            <span>Tienda</span>
          </a>
          <button
            id="mobile-menu-toggle"
            type="button"
            aria-label="Abrir menú de navegación"
            aria-expanded="false"
            class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-xl border border-stone-200 bg-white text-stone-800 hover:bg-stone-100"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú Desplegable Móvil -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200 bg-white px-4 py-4 shadow-lg">
        <div class="space-y-1 text-sm font-semibold text-stone-800">
          <a href="/prueba/" class="block rounded-xl px-3 py-2.5 hover:bg-stone-100">Inicio</a>
          <div class="pt-2 pb-1 px-3 text-[11px] font-bold uppercase tracking-wider text-amber-700">Servicios</div>
          <div class="grid grid-cols-2 gap-1 pl-2">
            <a href="/prueba/servicios/imprenta" class="rounded-lg px-3 py-2 text-xs font-medium text-stone-700 hover:bg-stone-100">Imprenta</a>
            <a href="/prueba/servicios/maquetacion-y-diseno-grafico" class="rounded-lg px-3 py-2 text-xs font-medium text-stone-700 hover:bg-stone-100">Maquetación</a>
            <a href="/prueba/servicios/produccion-editorial" class="rounded-lg px-3 py-2 text-xs font-medium text-stone-700 hover:bg-stone-100">Prod. Editorial</a>
            <a href="/prueba/servicios/gran-formato" class="rounded-lg px-3 py-2 text-xs font-medium text-stone-700 hover:bg-stone-100">Gran Formato</a>
            <a href="/prueba/servicios/fotografia" class="rounded-lg px-3 py-2 text-xs font-medium text-stone-700 hover:bg-stone-100">Fotografía</a>
            <a href="/prueba/servicios/video-profesional" class="rounded-lg px-3 py-2 text-xs font-medium text-stone-700 hover:bg-stone-100">Vídeo</a>
          </div>
          <div class="border-t border-stone-100 my-2 pt-2 space-y-1">
            <a href="/prueba/tienda" class="block rounded-xl px-3 py-2.5 hover:bg-stone-100">Tienda Editorial (23 libros)</a>
            <a href="/prueba/quien-soy" class="block rounded-xl px-3 py-2.5 hover:bg-stone-100">Quién soy</a>
            <a href="/prueba/contacto" class="block rounded-xl px-3 py-2.5 hover:bg-stone-100">Contacto y Presupuestos</a>
            <a href="/prueba/admin" class="block rounded-xl bg-stone-100 px-3 py-2.5 text-stone-900">Panel de Administración</a>
          </div>
          <div class="border-t border-stone-100 pt-3 flex items-center justify-between px-3 text-xs text-stone-600">
            <a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`} class="font-bold text-amber-700">{siteConfig.phone}</a>
            <a href={`https://wa.me/${siteConfig.whatsapp}`} target="_blank" rel="noopener noreferrer" class="rounded-full bg-emerald-600 px-3 py-1 font-bold text-white">WhatsApp</a>
          </div>
        </div>
      </div>
    </header>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var btn = document.getElementById('mobile-menu-toggle');
        var menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          btn.addEventListener('click', function () {
            var isHidden = menu.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', String(!isHidden));
          });
        }
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-stone-200 bg-stone-950 text-stone-300">
      <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-4">
          <div class="md:col-span-2 space-y-4">
            <h2 class="font-['Instrument_Serif',serif] text-3xl text-white">
              {siteConfig.brand}
            </h2>
            <p class="max-w-md text-sm leading-relaxed text-stone-400">
              {siteConfig.tagline}. Más de 80.000 licencias fotográficas vendidas a nivel internacional y producción editorial propia en Segovia.
            </p>
            <div class="flex flex-wrap gap-4 pt-2 text-sm">
              <a href={`mailto:${siteConfig.email}`} class="text-amber-400 hover:text-amber-300 underline underline-offset-4">
                {siteConfig.email}
              </a>
              <span class="text-stone-600">·</span>
              <a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`} class="hover:text-white">
                {siteConfig.phone}
              </a>
            </div>
            <div class="flex flex-wrap items-center gap-3 pt-2">
              <a
                href={siteConfig.social.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-stone-700 px-3.5 py-1.5 text-xs font-semibold text-stone-200 hover:border-amber-400 hover:text-amber-300 transition-colors"
              >
                Instagram ↗
              </a>
              <a
                href={siteConfig.social.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-stone-700 px-3.5 py-1.5 text-xs font-semibold text-stone-200 hover:border-amber-400 hover:text-amber-300 transition-colors"
              >
                Facebook ↗
              </a>
              <a
                href={siteConfig.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-stone-700 px-3.5 py-1.5 text-xs font-semibold text-stone-200 hover:border-amber-400 hover:text-amber-300 transition-colors"
              >
                LinkedIn ↗
              </a>
              <a
                href={siteConfig.social.shutterstock}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-amber-500/50 bg-amber-500/10 px-3.5 py-1.5 text-xs font-semibold text-amber-300 hover:bg-amber-500 hover:text-stone-950 transition-colors"
              >
                Shutterstock ↗
              </a>
            </div>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-400">Servicios</h3>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li><a href="/prueba/servicios/imprenta" class="hover:text-white transition-colors">Imprenta</a></li>
              <li><a href="/prueba/servicios/maquetacion-y-diseno-grafico" class="hover:text-white transition-colors">Maquetación y Diseño Gráfico</a></li>
              <li><a href="/prueba/servicios/produccion-editorial" class="hover:text-white transition-colors">Producción Editorial</a></li>
              <li><a href="/prueba/servicios/gran-formato" class="hover:text-white transition-colors">Gran Formato y Vinilos</a></li>
              <li><a href="/prueba/servicios/fotografia" class="hover:text-white transition-colors">Fotografía Aérea y Dron</a></li>
              <li><a href="/prueba/servicios/video-profesional" class="hover:text-white transition-colors">Vídeo Profesional</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-stone-400">Tienda y Gestión</h3>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li><a href="/prueba/tienda" class="hover:text-white transition-colors">Catálogo de Libros (23)</a></li>
              <li><a href="/prueba/admin" class="hover:text-white transition-colors">Panel de Autogestión (/prueba/admin)</a></li>
              <li><a href="/prueba/quien-soy" class="hover:text-white transition-colors">Quién soy</a></li>
              <li><a href="/prueba/contacto" class="hover:text-white transition-colors">Solicitar Presupuesto</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-stone-800 pt-8 md:flex-row md:items-center">
          <div class="flex flex-wrap items-center gap-4 text-xs text-stone-400">
            <a href="/prueba/aviso-legal" class="hover:text-white transition-colors">Aviso Legal</a>
            <span class="text-stone-700">·</span>
            <a href="/prueba/politica-de-devoluciones" class="hover:text-white transition-colors">Política de Devoluciones y Reembolsos</a>
            <span class="text-stone-700">·</span>
            <span>Diseño y desarrollo por MatarranzDev</span>
          </div>
          <p class="text-xs text-stone-500">
            © {new Date().getFullYear()} {siteConfig.fullName} · Segovia
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
