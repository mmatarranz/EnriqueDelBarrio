---
import BaseLayout from '../layouts/BaseLayout.astro';
import extraPages from '../data/extra-pages.json';
import siteConfig from '../data/site-config.json';

const page = (extraPages as Record<string, { title: string; body: string }>)['quien-soy'];
const paragraphs = (page?.body || '').split(/\n\n+/).filter(Boolean);
---

<BaseLayout title="Quién soy — Enrique del Barrio" description="Trayectoria profesional de Juan Enrique del Barrio Arribas: fotografía, imprenta, diseño gráfico, producción editorial y vídeo en Segovia.">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-12 items-start">
      <div class="md:col-span-4 space-y-4">
        <img
          src={siteConfig.images.portrait}
          alt={siteConfig.fullName}
          class="w-full rounded-3xl object-cover shadow-lg"
        />
        <div class="rounded-2xl border border-stone-200 bg-white p-5 space-y-2 text-sm">
          <p class="font-bold text-stone-950">{siteConfig.fullName}</p>
          <p class="text-stone-600">{siteConfig.location}</p>
          <p><a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`} class="font-semibold text-amber-700">{siteConfig.phone}</a></p>
          <p><a href={`mailto:${siteConfig.email}`} class="font-semibold text-amber-700">{siteConfig.email}</a></p>
          <a
            href="/prueba/contacto"
            class="mt-3 block w-full rounded-xl bg-stone-900 py-2.5 text-center text-xs font-bold text-white hover:bg-amber-700 transition-colors"
          >
            Contactar ahora
          </a>
        </div>
      </div>

      <div class="md:col-span-8 space-y-5">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Biografía y Trayectoria</span>
        <h1 class="font-['Instrument_Serif',serif] text-5xl text-stone-950">
          Juan Enrique del Barrio Arribas
        </h1>
        <div class="space-y-4 text-base leading-relaxed text-stone-700">
          {paragraphs.length > 0 ? (
            paragraphs.map((p) => <p>{p}</p>)
          ) : (
            <p>
              Profesional de la fotografía, el diseño gráfico, la imprenta, la producción editorial y el vídeo en Segovia. Autor de obras patrimoniales como la colección Segovia Callada y más de 80.000 licencias fotográficas vendidas en medios nacionales e internacionales.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
