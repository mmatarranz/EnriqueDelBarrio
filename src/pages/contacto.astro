---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../data/site-config.json';
---

<BaseLayout title="Contacto y Presupuestos — Enrique del Barrio" description="Solicita presupuesto de imprenta, producción editorial, fotografía profesional o vídeo en Segovia.">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="mb-10">
      <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Contacto Directo</span>
      <h1 class="mt-2 font-['Instrument_Serif',serif] text-5xl text-stone-950">
        Solicita presupuesto o consulta tu pedido
      </h1>
      <p class="mt-3 text-sm text-stone-600">
        Respuesta directa por correo, teléfono o WhatsApp sin formularios rotos ni intermediarios.
      </p>
    </div>

    <div class="grid gap-8 md:grid-cols-12">
      <div class="md:col-span-5 space-y-5 rounded-3xl bg-stone-950 p-8 text-white">
        <h2 class="font-['Instrument_Serif',serif] text-3xl">Datos de contacto</h2>
        <div class="space-y-3 text-sm text-stone-300">
          <p><strong class="text-white">Titular:</strong> {siteConfig.fullName}</p>
          <p><strong class="text-white">Teléfono:</strong> <a href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`} class="text-amber-400">{siteConfig.phone}</a></p>
          <p><strong class="text-white">Email:</strong> <a href={`mailto:${siteConfig.email}`} class="text-amber-400">{siteConfig.email}</a></p>
          <p><strong class="text-white">Estudio:</strong> {siteConfig.location}</p>
        </div>
        <div class="pt-4">
          <a
            href={`https://wa.me/${siteConfig.whatsapp}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 py-3 text-sm font-bold text-white hover:bg-emerald-500 transition-colors"
          >
            Abrir chat de WhatsApp
          </a>
        </div>
      </div>

      <form class="md:col-span-7 space-y-4 rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Nombre</label>
            <input type="text" required placeholder="Tu nombre" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm outline-none focus:border-amber-600 focus:bg-white" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-stone-700 mb-1">Email</label>
            <input type="email" required placeholder="tu@correo.es" class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm outline-none focus:border-amber-600 focus:bg-white" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone-700 mb-1">Servicio de interés</label>
          <select class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm outline-none focus:border-amber-600 focus:bg-white">
            <option>Imprenta</option>
            <option>Maquetación y Diseño Gráfico</option>
            <option>Producción Editorial (Edición de libro)</option>
            <option>Gran Formato, Expositores y Vinilos</option>
            <option>Fotografía Profesional / Dron</option>
            <option>Vídeo Profesional</option>
            <option>Consulta sobre Tienda de Libros</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-stone-700 mb-1">Mensaje</label>
          <textarea rows={5} required placeholder="Explícame qué necesitas, cantidades o fechas..." class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm outline-none focus:border-amber-600 focus:bg-white"></textarea>
        </div>
        <button type="submit" class="w-full rounded-xl bg-stone-900 py-3.5 text-sm font-bold text-white hover:bg-amber-700 transition-colors">
          Enviar consulta
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
