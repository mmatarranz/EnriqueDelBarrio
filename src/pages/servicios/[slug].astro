---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LightboxGallery from '../../components/LightboxGallery';
import VideoGrid from '../../components/VideoGrid';
import services from '../../data/services.json';
import videos from '../../data/videos.json';
import catalog from '../../data/catalog.json';
import siteConfig from '../../data/site-config.json';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const paragraphs = (service.body || '').split(/\n\n+/).filter(Boolean);
const editorialBooks = service.slug === 'produccion-editorial' ? catalog.slice(0, 4) : [];
---

<BaseLayout
  title={`${service.title} — Enrique del Barrio`}
  description={service.subtitle}
>
  <section class="border-b border-stone-200 bg-stone-950 text-white">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
      <a
        href="/prueba/#servicios"
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-amber-400 hover:text-amber-300"
      >
        ← Todos los servicios
      </a>
      <div class="mt-4 flex items-center gap-3">
        <span class="text-4xl">{service.icon}</span>
        <h1 class="font-['Instrument_Serif',serif] text-5xl sm:text-6xl">
          {service.title}
        </h1>
      </div>
      <p class="mt-4 max-w-2xl text-base text-stone-300">
        {service.subtitle}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8 space-y-14">
    {paragraphs.length > 0 && (
      <div class="w-full space-y-4 text-base leading-relaxed text-stone-700">
        {paragraphs.slice(0, 6).map((p) => (
          <p>{p}</p>
        ))}
      </div>
    )}

    {service.slug === 'produccion-editorial' && (
      <div class="space-y-8 rounded-3xl border border-stone-200 bg-white p-8 shadow-sm sm:p-10">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-amber-700">
            Metodología Editorial Integral · Llave en Mano
          </span>
          <h2 class="font-['Instrument_Serif',serif] text-4xl text-stone-950">
            Cómo transformamos tu manuscrito en un libro impreso de calidad
          </h2>
          <p class="text-sm leading-relaxed text-stone-600">
            Acompañamos a autores, ayuntamientos, asociaciones culturales y empresas durante todo el ciclo de publicación, resolviendo cada detalle técnico y artístico para que el resultado esté a la altura de tu obra.
          </p>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-stone-200/80 bg-stone-50 p-5 space-y-2">
            <span class="font-['Instrument_Serif',serif] text-3xl italic text-amber-700">01</span>
            <h3 class="text-base font-bold text-stone-950">Asesoramiento y Concepto</h3>
            <p class="text-xs leading-relaxed text-stone-600">
              Definimos formato, tipo de papel, encuadernación (tapa dura o rústica con solapas), tirada óptima y presupuesto cerrado sin sorpresas.
            </p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-stone-50 p-5 space-y-2">
            <span class="font-['Instrument_Serif',serif] text-3xl italic text-amber-700">02</span>
            <h3 class="text-base font-bold text-stone-950">Maquetación y Portada</h3>
            <p class="text-xs leading-relaxed text-stone-600">
              Diseño interior editorial limpio, tratamiento profesional de fotografías, retoque cromático y diseño de cubierta y lomo listo para librería.
            </p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-stone-50 p-5 space-y-2">
            <span class="font-['Instrument_Serif',serif] text-3xl italic text-amber-700">03</span>
            <h3 class="text-base font-bold text-stone-950">Pruebas, ISBN y Depósito Legal</h3>
            <p class="text-xs leading-relaxed text-stone-600">
              Revisión de galeradas y pruebas de color reales antes de entrar en máquina, además de gestión de ISBN, código de barras y Depósito Legal.
            </p>
          </div>
          <div class="rounded-2xl border border-stone-200/80 bg-stone-50 p-5 space-y-2">
            <span class="font-['Instrument_Serif',serif] text-3xl italic text-amber-700">04</span>
            <h3 class="text-base font-bold text-stone-950">Impresión y Entrega Final</h3>
            <p class="text-xs leading-relaxed text-stone-600">
              Control directo de calidad en imprenta, retractilado y entrega de los ejemplares listos para presentación, distribución o venta online.
            </p>
          </div>
        </div>
      </div>
    )}

    {service.slug === 'video-profesional' && (
      <div class="space-y-6">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
          <h2 class="font-['Instrument_Serif',serif] text-3xl text-stone-950">
            Selección de producciones audiovisuales ({videos.length} vídeos)
          </h2>
          <span class="text-xs font-medium text-stone-500">
            Carga instantánea bajo demanda (sin ralentizar el navegador)
          </span>
        </div>
        <VideoGrid client:load videoIds={videos} />
      </div>
    )}

    {service.slug === 'fotografia' && (
      <div class="flex flex-col items-start justify-between gap-4 rounded-2xl border border-amber-200 bg-amber-50/70 p-6 sm:flex-row sm:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-amber-800">
            Banco de Imágenes Internacional (+80.000 licencias)
          </p>
          <p class="mt-1 text-sm text-stone-700">
            ¿Buscas licenciar fotografías profesionales de Segovia, España o temática editorial al instante?
          </p>
        </div>
        <a
          href={siteConfig.social.shutterstock}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 rounded-full bg-stone-900 px-5 py-2.5 text-xs font-bold text-white hover:bg-amber-700 transition-colors"
        >
          Ver catálogo en Shutterstock ↗
        </a>
      </div>
    )}

    {service.gallery && service.gallery.length > 0 && (
      <div class="space-y-6">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
          <h2 class="font-['Instrument_Serif',serif] text-3xl text-stone-950">
            Galería de trabajos realizados
          </h2>
          <span class="text-xs font-medium text-stone-500">
            Pulsa en cualquier fotografía para ampliar en alta definición
          </span>
        </div>
        <LightboxGallery client:load images={service.gallery} title={service.title} />
      </div>
    )}

    {editorialBooks.length > 0 && (
      <div class="space-y-6">
        <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
          <div>
            <span class="text-xs font-bold uppercase tracking-widest text-amber-700">Muestra de Portfolio Editorial</span>
            <h2 class="mt-1 font-['Instrument_Serif',serif] text-3xl text-stone-950">
              Algunas de las obras editadas y maquetadas
            </h2>
          </div>
          <a href="/prueba/tienda" class="text-sm font-semibold text-amber-700 hover:underline">
            Ver catálogo completo en Tienda →
          </a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {editorialBooks.map((book) => (
            <a
              href={`/prueba/tienda/${book.slug}`}
              class="group flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm hover:shadow-md transition-all"
            >
              <div class="aspect-[3/4] bg-stone-100 p-4 flex items-center justify-center overflow-hidden">
                <img
                  src={book.image}
                  alt={book.name}
                  loading="lazy"
                  class="h-full w-full object-contain drop-shadow-md transition-transform duration-500 group-hover:scale-105"
                />
              </div>
              <div class="p-4">
                <h3 class="line-clamp-2 text-center text-sm font-bold text-stone-900 group-hover:text-amber-700 transition-colors">
                  {book.name}
                </h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- CTA contextual -->
    <div class="flex flex-col items-start justify-between gap-6 rounded-3xl bg-stone-900 p-8 text-white sm:flex-row sm:items-center sm:p-10">
      <div>
        <h3 class="font-['Instrument_Serif',serif] text-3xl">
          ¿Necesitas un presupuesto de {service.title.toLowerCase()}?
        </h3>
        <p class="mt-1 text-sm text-stone-300">
          Cuéntame los detalles de tu proyecto en Segovia o cualquier punto de España.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href="/prueba/contacto"
          class="rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-stone-950 hover:bg-amber-400 transition-colors"
        >
          Pedir presupuesto
        </a>
        <a
          href={`https://wa.me/${siteConfig.whatsapp}`}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-stone-600 px-6 py-3 text-sm font-semibold text-white hover:border-white transition-colors"
        >
          WhatsApp directo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
